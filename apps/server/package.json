{
  "name": "@scotland-yard-live/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@scotland-yard-live/contracts": "workspace:*",
    "@scotland-yard-live/database": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.2",
    "dotenv": "^16.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
